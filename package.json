{
  "name": "specsync",
  "version": "0.1.0",
  "description": "Collaborative spec review for AI coding agents. Your agent asks questions and submits specs — your team answers and reviews in the browser.",
  "type": "module",
  "bin": {
    "specsync": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "concurrently \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "specsync",
    "spec-review",
    "collaborative",
    "agent",
    "ai",
    "coding-agent",
    "qa",
    "review",
    "team",
    "claude",
    "cursor",
    "copilot",
    "kiro"
  ],
  "author": "Henri Graca",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hjgraca/specsync"
  },
  "homepage": "https://github.com/hjgraca/specsync",
  "bugs": {
    "url": "https://github.com/hjgraca/specsync/issues"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.1",
    "morgan": "^1.10.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
