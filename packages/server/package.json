{
  "name": "@specsync/server",
  "version": "0.1.0",
  "description": "Specsync server — collaborative spec review for AI coding agents",
  "type": "module",
  "bin": {
    "specsync-server": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "concurrently \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "specsync",
    "server",
    "collaborative",
    "review",
    "agent",
    "ai",
    "coding-agent"
  ],
  "author": "Henri Graca",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hjgraca/specsync",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/hjgraca/specsync",
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.1",
    "morgan": "^1.10.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@specsync/sdk": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
